---
import type { Post } from '../utils/posts';
import { readingTime } from '../utils/posts';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import MermaidLoader from '../components/MermaidLoader.astro';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags } = post.data;
---

<Base title={title} description={description} type="article">
  <article>
    <header>
      <p class="meta mono">
        <FormattedDate date={pubDate} />
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)}</span>
        {
          updatedDate && (
            <>
              <span aria-hidden="true">·</span>
              <span>
                updated <FormattedDate date={updatedDate} />
              </span>
            </>
          )
        }
      </p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {
        tags.length > 0 && (
          <p class="tags">
            {tags.map((tag) => (
              <a class="tag" href={`/tags/${tag}/`}>
                {tag}
              </a>
            ))}
          </p>
        )
      }
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  <MermaidLoader />
  <nav class="back mono"><a href="/blog/">← all writing</a></nav>
</Base>

<style>
  article header {
    margin-block: 3rem 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    color: var(--fg-faint);
    margin: 0;
  }
  h1 {
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    margin: 0.6rem 0 0.8rem;
  }
  .lede {
    font-size: 1.15rem;
    color: var(--fg-muted);
    margin: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 1.25rem 0 0;
  }
  .back {
    margin-top: 4rem;
  }
  .back a {
    color: var(--fg-muted);
    text-decoration: none;
  }
</style>
