---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  /** Break out of the text column. */
  wide?: boolean;
}
const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={['media', { wide }]}>
  <a href={src.src} class="zoom" aria-label={`Open full-size image: ${alt}`}>
    <Image
      src={src}
      alt={alt}
      widths={[640, 960, 1400, 2000].filter((w) => w <= src.width)}
      sizes={wide ? '(max-width: 64rem) 100vw, 64rem' : '(max-width: 42rem) 100vw, 42rem'}
    />
  </a>
  {(caption || Astro.slots.has('default')) && (
    <figcaption><slot>{caption}</slot></figcaption>
  )}
</figure>
