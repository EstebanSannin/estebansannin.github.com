---
interface Props {
  type?: 'note' | 'tip' | 'warning';
  title?: string;
}
const { type = 'note', title } = Astro.props;
const icons = { note: 'i', tip: '✓', warning: '!' };
---

<aside class:list={['callout', type]}>
  <p class="head mono">
    <span class="icon" aria-hidden="true">{icons[type]}</span>
    {title ?? type}
  </p>
  <div class="body"><slot /></div>
</aside>

<style>
  .callout {
    --c: var(--fg-muted);
    margin-block: 1.75em;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--c);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }
  .tip {
    --c: #16a34a;
  }
  .warning {
    --c: var(--accent);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.35rem;
    color: var(--c);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.75rem;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    border: 1.5px solid currentColor;
    font-size: 0.65rem;
  }
  .body :global(> :first-child) {
    margin-top: 0;
  }
  .body :global(> :last-child) {
    margin-bottom: 0;
  }
</style>
