---
import { AUTHOR, SOCIAL } from '../consts';
---

<footer class="wrap">
  <span>© {new Date().getFullYear()} {AUTHOR}</span>
  <span class="links">
    {
      SOCIAL.map(({ href, label }) => (
        <a href={href} rel={href.startsWith('http') ? 'me noopener' : undefined}>
          {label}
        </a>
      ))
    }
  </span>
</footer>

<style>
  footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 6rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-faint);
  }
  .links {
    display: flex;
    gap: 1.1rem;
  }
  a {
    color: var(--fg-muted);
    text-decoration: none;
  }
</style>
